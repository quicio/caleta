# --- API (Worker) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# --- Frontend (Vite) ---
# URL de la API que queda embebida en el build del web.
# En dev: http://127.0.0.1:8787
# En prod (default): https://caleta-api.<ACCOUNT_SUBDOMAIN>.workers.dev
VITE_API_URL=http://127.0.0.1:8787

# --- Deploy (Terraform/Cloudflare) ---
# API token con permisos: Workers Scripts:Edit, D1:Edit, Zone:Edit
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Subdominio único de tu cuenta (ej: "hugo" si tu workers.dev es hugo.workers.dev)
ACCOUNT_SUBDOMAIN=

# URL pública del frontend; tras OAuth redirige acá con #token=...
# En dev: http://localhost:5173
# En prod (default): https://caleta-web.<ACCOUNT_SUBDOMAIN>.workers.dev
WEB_URL=http://localhost:5173

# --- R2 (state de Terraform) ---
# Access key y secret de un API token de R2 con scope al bucket 'caleta-tfstate'.
# Ver infra/scripts/bootstrap-tfstate.sh y RUNBOOK §5.1.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=